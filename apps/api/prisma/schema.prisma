generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BUYER
  PROFESSIONAL
}

enum ProfileTier {
  REGISTERED
  EXPLORER
  ACTIVE_BUYER
  QUALIFIED
  PRIORITY
}

enum ProfessionalType {
  MORTGAGE_BROKER
  PROPERTY_AGENT
  PROPERTY_LAWYER
  TAX_ADVISOR
  HOME_INSPECTOR
  PROPERTY_VALUER
  INSURANCE_BROKER
}

enum VerificationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadQuality {
  HOT
  WARM
  COLD
}

enum LeadStatus {
  NEW
  CONTACTED
  MATCHED
  CLOSED
  LOST
}

enum MatchStatus {
  PENDING
  ACTIVE
  CONTACTED
  COMPLETED
  CANCELLED
}

enum StoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BuyerJourneyStatus {
  STARTED
  FINANCING
  PROFESSIONAL_MATCHING
  PROPERTY_REVIEW
  LEGAL_REVIEW
  READY_TO_BUY
  COMPLETED
  CANCELLED
}

enum PurchaseGoal {
  PRIMARY_RESIDENCE
  SECONDARY_RESIDENCE
  INVESTMENT
  RELOCATION
  OTHER
}

enum FinancingType {
  CASH
  MORTGAGE
  MIXED
  UNDECIDED
}

enum PurchaseTimeline {
  ASAP
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_TO_TWELVE_MONTHS
  MORE_THAN_ONE_YEAR
  UNDECIDED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  fullName String?
  role     Role    @default(BUYER)

  profileCompletion Int         @default(20)
  profileTier       ProfileTier @default(REGISTERED)

  phone     String?
  country   String?
  city      String?
  avatarUrl String?

  emailNotifications         Boolean @default(true)
  leadNotifications          Boolean @default(true)
  matchNotifications         Boolean @default(true)
  propertyAlertNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalProfile ProfessionalProfile?
  leads               Lead[]
  matchesAsBuyer      Match[]              @relation("BuyerMatches")
  stories             Story[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  savedProperties     SavedProperty[]
  reviewsGiven        Review[]             @relation("BuyerReviews")
  buyerJourneys       BuyerJourney[]
}

model ProfessionalProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  professionalType   ProfessionalType
  companyName        String?
  bio                String?
  languages          String[]
  rating             Float              @default(0)
  reviewsCount       Int                @default(0)
  clientsCount       Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  isFeatured         Boolean            @default(false)
  profileCompletion  Int                @default(0)

  // Professional verification
  verificationDocumentUrl      String?
  verificationDocumentName     String?
  verificationDocumentMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches    Match[]    @relation("ProfessionalMatches")
  properties Property[]
  reviews    Review[]
}

model Property {
  id                    String @id @default(uuid())
  professionalProfileId String

  title        String
  description  String?
  location     String?
  region       String?
  city         String?
  price        Float
  propertyType String?
  status       PropertyStatus @default(DRAFT)
  featured     Boolean        @default(false)

  bedrooms         Int?
  bathrooms        Int?
  area             Float?
  landArea         Float?
  constructionYear Int?
  equipments       String[]
  imageUrls        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  savedBy             SavedProperty[]
  matches             Match[]
  buyerJourneys       BuyerJourney[]
}

model SavedProperty {
  id String @id @default(uuid())

  userId     String
  propertyId String

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([userId, createdAt])
}

model Lead {
  id     String  @id @default(uuid())
  userId String?

  fullName String?
  email    String?
  phone    String?

  source   String?
  interest String?
  location String?
  budget   String?

  // Critères structurés de la recherche
  propertyType String?
  bedrooms     Int?
  bathrooms    Int?
  minBudget    Float?
  maxBudget    Float?
  minArea      Float?
  maxArea      Float?
  goal         String?
  mustHave     String[]
  searchText   String?
  aiSummary    String?
  confidence   Int?

  // Recherche persistante
  isActive             Boolean   @default(true)
  notificationsEnabled Boolean   @default(true)
  lastMatchedAt        DateTime?

  quality LeadQuality @default(COLD)
  status  LeadStatus  @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  matches Match[]

  @@index([userId])
  @@index([location])
  @@index([status, createdAt])
  @@index([isActive, notificationsEnabled])
}

model Match {
  id             String  @id @default(uuid())
  buyerId        String?
  professionalId String
  leadId         String?
  propertyId     String?

  score  Int         @default(0)
  status MatchStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer User? @relation("BuyerMatches", fields: [buyerId], references: [id], onDelete: SetNull)

  professional ProfessionalProfile @relation("ProfessionalMatches", fields: [professionalId], references: [id], onDelete: Cascade)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  chatRoom ChatRoom?
  review   Review?

  @@unique([leadId, professionalId])
  @@index([buyerId])
  @@index([professionalId])
  @@index([leadId])
  @@index([propertyId])
}

model Story {
  id     String  @id @default(uuid())
  userId String?

  title      String
  excerpt    String?
  content    String?
  author     String?
  location   String?
  imageUrl   String?
  status     StoryStatus @default(PENDING)
  isVerified Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType

  isRead Boolean @default(false)

  propertyId String?
  leadId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum NotificationType {
  MATCH
  LEAD
  STORY
  SYSTEM
  PROPERTY_REQUEST
  PROPERTY_MATCH
}

model ChatRoom {
  id             String @id @default(uuid())
  matchId        String @unique
  buyerId        String
  professionalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match    Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id         String  @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String
  isRead     Boolean @default(false)

  status String    @default("SENT")
  readAt DateTime?

  createdAt DateTime @default(now())
  chatRoom  ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
}

model Neighborhood {
  id String @id @default(uuid())

  name        String  @unique
  zone        String?
  description String?

  tags       String[]
  highlights String[]

  avgPrice      Int?
  pricePerSqm   Int?
  rentYield     Float?
  growthPercent Float?

  schoolsCount   Int @default(0)
  transportCount Int @default(0)
  amenitiesCount Int @default(0)

  schoolsScore   Float?
  transportScore Float?
  amenitiesScore Float?
  safetyScore    Float?

  aiScore   Int?
  aiSummary String?

  icon      String?
  latitude  Float?
  longitude Float?

  sourceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())

  userId   String?
  userRole Role?

  action   String
  entity   String?
  entityId String?

  description String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id String @id @default(uuid())

  rating  Int
  comment String?

  status ReviewStatus @default(PENDING)

  buyerId String
  buyer   User   @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([professionalId])
  @@index([status])
}

model ContactMessage {
  id String @id @default(uuid())

  name    String
  email   String
  subject String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isRead])
  @@index([createdAt])
}

model BuyerJourney {
  id String @id @default(uuid())

  // =========================================================
  // RELATIONS
  // =========================================================

  buyerId    String
  propertyId String

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // =========================================================
  // PURCHASE PROJECT
  // =========================================================

  goal PurchaseGoal?

  estimatedBudget  Float?
  availableDeposit Float?

  financingType FinancingType @default(UNDECIDED)

  timeline PurchaseTimeline @default(UNDECIDED)

  // =========================================================
  // PROFESSIONAL SUPPORT
  // =========================================================

  needsMortgageBroker  Boolean @default(false)
  needsPropertyLawyer  Boolean @default(false)
  needsTaxAdvisor      Boolean @default(false)
  needsInsuranceBroker Boolean @default(false)

  // =========================================================
  // JOURNEY PROGRESS
  // =========================================================

  status BuyerJourneyStatus @default(STARTED)

  progress Int @default(10)

  notes String?

  // =========================================================
  // TIMESTAMPS
  // =========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A buyer should not create the same journey twice
  // for the same property.
  @@unique([buyerId, propertyId])
  @@index([buyerId])
  @@index([propertyId])
  @@index([status])
  @@index([buyerId, status])
  @@index([createdAt])
}
